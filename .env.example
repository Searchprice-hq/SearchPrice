# URL da searchprice-master-api (sem barra no final)
SEARCHPRICE_API_URL=http://localhost:3345
# Chave esperada pelo ApiTokenMiddleware da API (header x-api-key).
# Fica só no servidor do Next — nunca use o prefixo NEXT_PUBLIC_.
SEARCHPRICE_API_KEY=

# Mock: o front roda sozinho, com dados de demonstração (padrão).
# Use "false" para consumir a searchprice-master-api.
NEXT_PUBLIC_USE_MOCKS=true
